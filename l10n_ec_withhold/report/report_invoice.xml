<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- NOTE: withhold-specific rendering (calling e_withhold_document_body
         and skipping the generic tax_totals fallback for entry-type moves)
         is handled directly inside l10n_ec_account_edi's own
         report_invoice_document template (see the `internal_type ==
         'withhold'` branch in l10n_ec_account_edi/report/report_invoice.xml)
         instead of living here as a separate `primary="True"` inherited
         copy. The old approach broke when that view's redesigned RIDE
         layout replaced its original internal structure
         (electronic_report_common_head / electronic_report_common_total_info
         anchors) wholesale, since a primary inherited view combines all
         non-primary extensions of its target before applying its own
         xpaths — so these two xpaths could no longer find their anchors.
         Calling the shared view directly below picks up that logic
         automatically without needing a separate primary copy at all. -->
    <template id="report_withhold_ec">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="o.partner_id.lang" />
                <t
                    t-call="l10n_ec_account_edi.report_invoice_document"
                    t-lang="lang"
                />
            </t>
        </t>
    </template>

    <record id="action_report_withholding_ec" model="ir.actions.report">
        <field name="name">Withholding EC</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_ec_withhold.report_withhold_ec</field>
        <field name="report_file">l10n_ec_withhold.report_withhold_ec</field>
        <field name="print_report_name">(object._get_report_base_filename())</field>
        <field name="attachment" />
        <field name="binding_model_id" ref="account.model_account_move" />
        <field name="binding_type">report</field>
        <field
            name="groups_id"
            eval="[(4, ref('account.group_account_invoice')), (4, ref('account.group_account_readonly'))]"
        />
    </record>
</odoo>
