<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_account_journal_form_sequence"
        model="ir.ui.view">
        <field name="name">account.journal.form.l10n.ec.sequence</field>
        <field name="model">account.journal</field>
        <field name="inherit_id"
            ref="l10n_ec.view_account_journal_form" />
        <field name="arch"
            type="xml">
            <field name="l10n_ec_emission_address_id" position="after">
                <field name="l10n_ec_sequence_start"
                    invisible="not l10n_ec_require_emission" />
            </field>
        </field>
    </record>
</odoo>
