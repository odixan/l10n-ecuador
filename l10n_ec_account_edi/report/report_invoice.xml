<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="report_invoice" inherit_id="account.report_invoice">
        <t t-call="web.html_container" position="before">
            <t
                t-if="docs.filtered(lambda d: d._get_name_invoice_report() == 'l10n_ec_account_edi.report_invoice_document')"
            >
                <t t-set="data_report_margin_top">5</t>
            </t>
        </t>
        <xpath expr='//t[@t-call="account.report_invoice_document"]' position="after">
            <t
                t-if="o._get_name_invoice_report() == 'l10n_ec_account_edi.report_invoice_document'"
                t-call="l10n_ec_account_edi.report_invoice_document"
                t-lang="lang"
            />
        </xpath>
    </template>

    <!-- ================================================================
         Single self-contained document template — the whole `div.article`
         body is defined here directly (custom RIDE layout: rounded-corner
         Emisor/Factura boxes, plain-bordered customer info block, line
         items with an "Adicional" column, gray-shaded table headers).

         The only thing this still calls out to other modules for is the
         per-document-type body for purchase liquidations / credit notes /
         debit notes (this module) and withholds (l10n_ec_withhold, if
         installed — the t-if guard means the call is never reached
         otherwise, since no move can have that internal_type without it).
         ================================================================ -->
    <template id="report_invoice_document">
        <t t-set="o" t-value="o.with_context(lang=lang)" />
        <!-- Multicompany -->
        <t t-if="o and 'company_id' in o">
            <t t-set="company" t-value="o.company_id.sudo()" />
        </t>
        <t t-if="not o or not 'company_id' in o">
            <t t-set="company" t-value="res_company" />
        </t>
        <t
            t-set="edi_doc"
            t-value="o.edi_document_ids.filtered(lambda x:
             x.edi_format_id.code == 'l10n_ec_format_sri')"
        />
        <!-- For historical invoices (no EDI doc), use the manually entered access key -->
        <t
            t-set="access_key"
            t-value="edi_doc.l10n_ec_xml_access_key or o.l10n_ec_electronic_authorization"
        />

        <t
            t-set="emission_address"
            t-value="o.journal_id.l10n_ec_emission_address_id "
        />
        <t t-set="partner" t-value="o.commercial_partner_id" />
        <t
            t-set="document_string"
            t-value="o.l10n_latam_document_type_id.report_name"
        />
        <t t-set="document_number" t-value="o.l10n_latam_document_number" />
        <t t-set="document_date" t-value="o.invoice_date" />
        <t t-set="payments_info" t-value="o._l10n_ec_get_payment_data()" />
        <t
            t-set="ordered_lines"
            t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"
        />
        <div
            class="article"
            t-att-data-oe-model="o and o._name"
            t-att-data-oe-id="o and o.id"
            t-att-data-oe-lang="o and o.env.context.get('lang')"
        >
            <!-- ============================================
                 Local style override, embedded directly in the
                 document HTML (not via the web.report_assets_common
                 bundle). The bundled .table-no-border / .div-bordered /
                 .div-radius rules from this module's own
                 static/src/scss/report_layout.scss do not reliably apply
                 inside the real wkhtmltopdf render pipeline, so borders we
                 want removed (Bootstrap's default table/td borders) keep
                 leaking through. Re-declaring the override inline here, as
                 part of the page's own HTML, renders correctly.
                 ============================================ -->
            <style>
                table.table-no-border,
                table.table-no-border > thead > tr > th,
                table.table-no-border > tbody > tr > th,
                table.table-no-border > tfoot > tr > th,
                table.table-no-border > thead > tr > td,
                table.table-no-border > tbody > tr > td,
                table.table-no-border > tfoot > tr > td {
                    border: none !important;
                }
            </style>
            <t
                t-set="is_factura"
                t-value="o.l10n_latam_document_type_id.internal_type == 'invoice' and o.move_type == 'out_invoice'"
            />
            <t t-set="company_logo" t-value="company.logo" />

            <!-- ============================================
                 HEADER: Emisor box | Document/authorization box
                 (both bordered, rounded corners)
                 ============================================ -->
            <div style="font-size:11px; padding-top:10px; padding-bottom:10px;">
                <table class="table-no-border" style="width:100%; border-collapse:collapse;">
                    <tr>
                        <!-- LEFT: logo + Emisor bordered box -->
                        <td style="width:50%; vertical-align:top; padding-right:8px;">
                            <t t-if="company_logo">
                                <div style="text-align:center; margin-bottom:6px;">
                                    <img
                                        t-att-src="image_data_uri(company_logo)"
                                        style="max-height:120px; max-width:100%;"
                                        alt="Logo"
                                    />
                                </div>
                            </t>
                            <div style="border:1px solid black; border-radius:5px; padding:8px;">
                                <table class="table-no-border" style="width:100%; border-collapse:collapse; font-size:10px;">
                                    <tr>
                                        <td style="width:40%; padding:2px 4px;">
                                            <strong>Emisor:</strong>
                                        </td>
                                        <td style="padding:2px 4px;">
                                            <span t-field="company.name" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding:2px 4px;">
                                            <strong>RUC:</strong>
                                        </td>
                                        <td style="padding:2px 4px;">
                                            <span t-field="company.partner_id.vat" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding:2px 4px;">
                                            <strong>Matriz:</strong>
                                        </td>
                                        <td style="padding:2px 4px;">
                                            <span t-field="company.partner_id.street" />
                                        </td>
                                    </tr>
                                    <t
                                        t-if="company.partner_id.street != emission_address.street"
                                    >
                                        <tr>
                                            <td style="padding:2px 4px;">
                                                <strong>Dir. Sucursal:</strong>
                                            </td>
                                            <td style="padding:2px 4px;">
                                                <span t-out="emission_address.street" />
                                            </td>
                                        </tr>
                                    </t>
                                    <tr>
                                        <td style="padding:2px 4px;">
                                            <strong>Email:</strong>
                                        </td>
                                        <td style="padding:2px 4px;">
                                            <span t-field="company.partner_id.email" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding:2px 4px;">
                                            <strong>Teléfono:</strong>
                                        </td>
                                        <td style="padding:2px 4px;">
                                            <span t-field="company.partner_id.phone" />
                                        </td>
                                    </tr>
                                    <t
                                        t-set="contribuyente_especial"
                                        t-value="company.l10n_ec_get_resolution_data(document_date)"
                                    />
                                    <t t-if="contribuyente_especial">
                                        <tr>
                                            <td style="padding:2px 4px;">
                                                <strong>Contrib. Especial Nro:</strong>
                                            </td>
                                            <td style="padding:2px 4px;">
                                                <span t-out="contribuyente_especial" />
                                            </td>
                                        </tr>
                                    </t>
                                    <tr>
                                        <td
                                            colspan="2"
                                            style="padding:2px 4px;"
                                        >
                                            <strong>Obligado a llevar contabilidad:</strong>
                                            <span
                                                t-out="o.env['account.edi.document']._l10n_ec_get_required_accounting(company.partner_id.property_account_position_id)"
                                            />
                                        </td>
                                    </tr>
                                    <t t-if="company.l10n_ec_retention_agent">
                                        <tr>
                                            <td colspan="2" style="padding:2px 4px;">
                                                <strong>Agente Retención Res. No</strong>
                                                <span
                                                    t-out="company.l10n_ec_retention_agent"
                                                />
                                            </td>
                                        </tr>
                                    </t>
                                    <t t-if="company.l10n_ec_get_regimen()">
                                        <tr>
                                            <td colspan="2" style="padding:2px 4px;">
                                                <span t-out="company.l10n_ec_get_regimen()" />
                                            </td>
                                        </tr>
                                    </t>
                                </table>
                            </div>
                        </td>

                        <!-- RIGHT: document title + authorization block -->
                        <td style="width:50%; vertical-align:top; padding-left:8px;">
                            <div
                                style="border-left:1px solid black; border-right:1px solid black; border-bottom:1px solid black; border-top:none; border-radius:5px; min-height:260px; padding:10px;"
                            >
                                <div
                                    style="text-align:center; font-size:18px; font-weight:bold; margin-bottom:8px;"
                                >
                                    <span t-out="document_string" />
                                </div>
                                <div style="margin-bottom:6px;">
                                    <strong>No.</strong>
                                    <span t-out="document_number" />
                                </div>
                                <div style="margin-bottom:2px;">
                                    <strong>NÚMERO DE AUTORIZACIÓN</strong>
                                </div>
                                <div
                                    style="margin-bottom:8px; font-size:9px; word-break:break-all;"
                                >
                                    <span t-out="access_key" />
                                </div>
                                <div style="margin-bottom:2px;">
                                    <strong>FECHA Y HORA DE AUTORIZACIÓN</strong>
                                </div>
                                <div style="margin-bottom:8px;">
                                    <t t-if="edi_doc">
                                        <span t-field="edi_doc.l10n_ec_authorization_date" />
                                    </t>
                                    <t t-if="not edi_doc and o.l10n_ec_is_historical">
                                        <span t-field="o.invoice_date" />
                                    </t>
                                </div>
                                <!-- Emission type -->
                                <div style="margin-bottom:2px;">
                                    <strong>TIPO EMISIÓN:</strong>
                                    Normal
                                </div>
                                <!-- Environment -->
                                <div style="margin-bottom:8px;">
                                    <strong>AMBIENTE:</strong>
                                    <span t-field="company.l10n_ec_type_environment" />
                                </div>
                                <div style="margin-bottom:4px;">
                                    <strong>CLAVE DE ACCESO:</strong>
                                </div>
                                <t t-if="access_key">
                                    <div style="text-align:center;">
                                        <img
                                            class="barcode"
                                            t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s&amp;' % ('Code128', access_key, 440, 80)"
                                            alt="Clave de Acceso"
                                            style="width:100%;"
                                        />
                                    </div>
                                    <div
                                        style="text-align:center; font-size:8px; word-break:break-all; margin-top:2px;"
                                    >
                                        <span t-out="access_key" />
                                    </div>
                                </t>
                            </div>
                        </td>
                    </tr>
                </table>
            </div>

            <!-- ============================================
                 BODY — per document type
                 ============================================ -->
            <t t-if="is_factura">
                <!-- Customer info: plain bordered box, sharp corners, no title -->
                <div style="border:1px solid black; margin-bottom:6px;">
                    <table
                        class="table table-sm table-no-border small"
                        style="margin:0; font-size:10px;"
                    >
                        <tbody>
                            <tr>
                                <td style="width:20%; padding:2px 6px;">
                                    <strong>Identificación:</strong>
                                </td>
                                <td style="width:30%; padding:2px 6px;">
                                    <span t-field="partner.vat" />
                                </td>
                                <td style="width:15%; padding:2px 6px;">
                                    <strong>Email:</strong>
                                </td>
                                <td style="padding:2px 6px;">
                                    <span
                                        t-out="partner.email or (partner.child_ids and partner.child_ids[0].email) or ''"
                                    />
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:2px 6px;">
                                    <strong>Razón Social:</strong>
                                </td>
                                <td style="padding:2px 6px;">
                                    <span t-field="partner.name" />
                                </td>
                                <td style="padding:2px 6px;">
                                    <strong>Teléfono:</strong>
                                </td>
                                <td style="padding:2px 6px;">
                                    <span
                                        t-out="partner.phone or (partner.child_ids and partner.child_ids[0].phone) or ''"
                                    />
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:2px 6px;">
                                    <strong>Fecha Emisión:</strong>
                                </td>
                                <td style="padding:2px 6px;">
                                    <span t-field="o.invoice_date" />
                                </td>
                                <td style="padding:2px 6px;">
                                    <strong>Fecha Vencimiento:</strong>
                                </td>
                                <td style="padding:2px 6px;">
                                    <span t-field="o.invoice_date_due" />
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:2px 6px;">
                                    <strong>Dirección:</strong>
                                </td>
                                <td colspan="3" style="padding:2px 6px;">
                                    <span
                                        t-out="partner.street or (partner.child_ids and partner.child_ids[0].street) or ''"
                                    />
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Line items: Código, Cant., Detalle, Adicional, Precio Unitario, Descuento, Total -->
                <br />
                <t t-set="add_info_map" t-value="o._l10n_ec_get_additional_info_map()" />
                <t t-call="l10n_ec_account_edi.electronic_report_line_items_table" />
            </t>

            <t
                t-if="o.l10n_latam_document_type_id.internal_type == 'purchase_liquidation' and o.move_type == 'in_invoice'"
            >
                <t t-call="l10n_ec_account_edi.e_liquidation_document_body" />
            </t>
            <t
                t-if="o.l10n_latam_document_type_id.internal_type == 'credit_note' and o.move_type == 'out_refund'"
            >
                <t t-call="l10n_ec_account_edi.e_credit_note_document_body" />
            </t>
            <t
                t-if="o.l10n_latam_document_type_id.internal_type == 'debit_note' and o.move_type == 'out_invoice'"
            >
                <t t-call="l10n_ec_account_edi.e_debit_note_document_body" />
            </t>
            <t
                t-if="o.l10n_latam_document_type_id.internal_type == 'withhold'"
            >
                <!-- Only reachable if l10n_ec_withhold is installed, since no
                     move can have this internal_type otherwise. -->
                <t t-call="l10n_ec_withhold.e_withhold_document_body" />
            </t>

            <!-- ============================================
                 BOTTOM: Información Adicional + Forma de Pago (left)
                 | Totals (right)
                 ============================================ -->
            <table class="table table-sm table-no-border">
                <tbody>
                    <tr>
                        <td style="width: 50%">
                            <div class="small" style="border:1px solid black; padding:4px 6px;">
                                <strong>Información Adicional</strong>
                                <br />
                                <t t-if="comment">
                                    <span t-out="comment" />
                                    <br />
                                </t>
                                <t
                                    t-if="(not is_factura) and (partner.street or (partner.child_ids and partner.child_ids[0].street))"
                                >
                                    <strong>Dirección:</strong>
                                    <span
                                        t-out="partner.street or (partner.child_ids and partner.child_ids[0].street) or ''"
                                    />
                                    <br />
                                </t>
                                <t
                                    t-if="(not is_factura) and (partner.phone or (partner.child_ids and partner.child_ids[0].phone))"
                                >
                                    <strong>Telefono:</strong>
                                    <span
                                        t-out="partner.phone or (partner.child_ids and partner.child_ids[0].phone) or ''"
                                    />
                                    <br />
                                </t>
                                <t
                                    t-if="(not is_factura) and (partner.email or (partner.child_ids and partner.child_ids[0].email))"
                                >
                                    <strong>Email:</strong>
                                    <span
                                        t-out="partner.email or (partner.child_ids and partner.child_ids[0].email) or ''"
                                    />
                                    <br />
                                </t>
                                <t t-if="'l10n_ec_additional_information_move_ids' in o">
                                    <t
                                        t-foreach="o._l10n_ec_get_additional_info_summary()"
                                        t-as="info_additional"
                                    >
                                        <strong t-field="info_additional.name" />:
                                        <span t-field="info_additional.description" />
                                        <br />
                                    </t>
                                </t>
                            </div>
                            <br />
                            <t
                                t-if="o.move_type in ('out_invoice', 'in_invoice')"
                                t-call="l10n_ec_account_edi.electronic_report_common_payment_info"
                            />
                        </td>
                        <td style="width: 40%">
                            <t
                                t-if="is_factura or o.l10n_latam_document_type_id.internal_type == 'credit_note'"
                            >
                                <t t-set="sri" t-value="o._l10n_ec_get_totals_sri()" />
                                <t t-call="l10n_ec_account_edi.electronic_report_sri_totals" />
                            </t>
                            <t
                                t-elif="o.l10n_latam_document_type_id.internal_type == 'withhold'"
                            >
                                <!-- Withholding documents render their own totals
                                     inside e_withhold_document_body above; skip the
                                     generic tax_totals fallback below since
                                     o.tax_totals is None for entry-type moves. -->
                            </t>
                            <t t-else="">
                                <!-- Fallback: standard Odoo totals for other document types -->
                                <table class="table table-sm table-bordered-black small">
                                    <t t-set="currency" t-value="o.currency_id" />
                                    <t t-set="tax_totals" t-value="o.tax_totals" />
                                    <t t-call="account.document_tax_totals" />
                                </table>
                            </t>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <t t-call="l10n_ec_account_edi.electronic_report_page_footer" />
    </template>

    <!-- ================================================================
         Shared line-items table: Código, Cant., Detalle, Adicional,
         Precio Unitario, Descuento, Total. Extracted out of
         report_invoice_document's is_factura branch so credit notes
         (report_edi_credit_note.xml) render identical columns/styling
         instead of maintaining a second copy of this markup.

         Expects "ordered_lines", "add_info_map" and "res_company" to
         already be set in the calling context (t-call inherits the
         caller's rendering context, so no explicit params are needed —
         same convention as electronic_report_common_payment_info below).
         ================================================================ -->
    <template id="electronic_report_line_items_table">
        <table class="table table-sm table-bordered-black">
            <thead>
                <tr style="font-size:10px; background-color:#f0f0f0;">
                    <th class="amount-md text-center">Código</th>
                    <th class="amount-sm text-center">Cant.</th>
                    <th class="text-center">Detalle</th>
                    <th class="amount-md text-center">Adicional</th>
                    <th class="amount-md text-center">Precio Unitario</th>
                    <th class="amount-sm text-center">Descuento</th>
                    <th class="amount-md text-center">Total</th>
                </tr>
            </thead>
            <tbody>
                <t t-foreach="ordered_lines" t-as="line">
                    <tr
                        style="font-size:9px;"
                        t-if="line.display_type == 'product'"
                    >
                        <td class="text-center">
                            <span
                                t-out="line.product_id and line.product_id.default_code or 'S/N'"
                            />
                        </td>
                        <td class="text-right">
                            <span t-field="line.quantity" />
                        </td>
                        <td>
                            <span t-field="line.name" />
                        </td>
                        <td class="text-center">
                            <span
                                t-out="add_info_map.get(line.product_id and line.product_id.default_code) or ''"
                            />
                        </td>
                        <td class="text-right">
                            <!-- SRI requires 6 decimal places for precio unitario -->
                            <span
                                t-out="'$%s' % ('{:,.6f}'.format(line.price_unit),)"
                            />
                        </td>
                        <td class="text-right">
                            <!-- Show discount amount (not percentage) -->
                            <span
                                t-out="'$%s' % ('{:,.2f}'.format(line.price_unit * line.quantity * (line.discount or 0.0) / 100),)"
                            />
                        </td>
                        <td class="text-right">
                            <span
                                t-out="'$%s' % ('{:,.2f}'.format(line.price_subtotal),)"
                            />
                        </td>
                    </tr>
                    <t t-if="line.display_type == 'line_section'">
                        <tr>
                            <td colspan="7">
                                <span t-field="line.name" />
                            </td>
                        </tr>
                    </t>
                    <t t-if="line.display_type == 'line_note'">
                        <tr>
                            <td colspan="7">
                                <span t-field="line.name" />
                            </td>
                        </tr>
                    </t>
                </t>
            </tbody>
        </table>
    </template>

    <!-- ================================================================
         Shared SRI tax totals block (SUBTOTAL 15%/12%/0%/exento/no-objeto,
         TOTAL DESCUENTO, SUBTOTAL CON DESCUENTO, ICE, IVA 15%/12%,
         SERVICIO 10%, IRBPNR, VALOR TOTAL). Extracted out of
         report_invoice_document's is_factura branch so credit notes get
         the exact same totals breakdown as invoices, computed via the
         same _l10n_ec_get_totals_sri() method.

         Expects "sri" (the dict returned by _l10n_ec_get_totals_sri())
         to already be set in the calling context.
         ================================================================ -->
    <template id="electronic_report_sri_totals">
        <table
            class="table table-sm table-no-border small"
            style="width:100%; font-size:10px; margin-bottom:0;"
        >
            <tbody>
                <t t-if="sri['subtotal_15'] or sri['iva_15']">
                    <tr>
                        <td
                            class="text-right"
                            style="padding:1px 4px; white-space:nowrap;"
                        >
                            <strong>SUBTOTAL 15%:</strong>
                        </td>
                        <td
                            class="text-right"
                            style="padding:1px 4px; min-width:80px; white-space:nowrap;"
                        >
                            <span
                                t-out="'$ {:,.2f}'.format(sri['subtotal_15'])"
                            />
                        </td>
                    </tr>
                </t>
                <t t-if="sri['subtotal_12'] or sri['iva_12']">
                    <tr>
                        <td
                            class="text-right"
                            style="padding:1px 4px; white-space:nowrap;"
                        >
                            <strong>SUBTOTAL 12%:</strong>
                        </td>
                        <td
                            class="text-right"
                            style="padding:1px 4px; white-space:nowrap;"
                        >
                            <span
                                t-out="'$ {:,.2f}'.format(sri['subtotal_12'])"
                            />
                        </td>
                    </tr>
                </t>
                <tr>
                    <td
                        class="text-right"
                        style="padding:1px 4px; white-space:nowrap;"
                    >
                        <strong>SUBTOTAL 0%:</strong>
                    </td>
                    <td
                        class="text-right"
                        style="padding:1px 4px; white-space:nowrap;"
                    >
                        <span
                            t-out="'$ {:,.2f}'.format(sri['subtotal_0'])"
                        />
                    </td>
                </tr>
                <tr>
                    <td
                        class="text-right"
                        style="padding:1px 4px; white-space:nowrap;"
                    >
                        <strong>SUBTOTAL NO OBJETO IVA:</strong>
                    </td>
                    <td
                        class="text-right"
