<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- RIDE body for credit notes (Nota de Crédito). Uses the same
         inline-style bordered-box pattern as report_invoice_document's
         customer-info box (not the div-bordered/table-no-border classes,
         which don't reliably render borders in the real wkhtmltopdf
         pipeline — see the note in report_invoice_document). Line items
         reuse the exact same shared table as the invoice
         (electronic_report_line_items_table in report_invoice.xml) for
         visual consistency; SRI tax totals for credit notes are rendered
         by the credit_note branch already added to
         report_invoice_document's totals section, not here. -->
    <template id="e_credit_note_document_body">
        <div style="border:1px solid black; margin-bottom:6px;">
            <table
                class="table table-sm table-no-border small"
                style="margin:0; font-size:10px;"
            >
                <tbody>
                    <tr>
                        <td style="width:60%; padding:2px 6px;">
                            <strong>Razón Social / Nombres y Apellidos:</strong>
                            <span t-field="partner.name" />
                        </td>
                        <td style="padding:2px 6px;">
                            <strong>Identificación:</strong>
                            <span t-field="partner.vat" />
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:2px 6px;">
                            <strong>Fecha Emisión:</strong>
                            <span t-field="o.invoice_date" />
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:2px 6px;">
                            <strong>Comprobante que se modifica:</strong>
                            FACTURA
                            <span t-field="o.l10n_ec_legacy_document_number" />
                        </td>
                        <td style="padding:2px 6px;">
                            <strong>Razón de modificación:</strong>
                            <span t-field="o.l10n_ec_reason" />
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:2px 6px;">
                            <strong>Fecha Emisión (Comprobante a modificar):</strong>
                            <span t-field="o.l10n_ec_legacy_document_date" />
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <br />
        <t t-set="add_info_map" t-value="o._l10n_ec_get_additional_info_map()" />
        <t t-call="l10n_ec_account_edi.electronic_report_line_items_table" />
    </template>
</odoo>
